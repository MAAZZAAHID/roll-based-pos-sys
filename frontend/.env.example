# ============================================================
# Retail POS — Frontend Environment Variables
# Copy this file to .env.local for local dev.
# For production, set VITE_API_URL in your hosting provider dashboard.
# NEVER put DATABASE_URL or JWT_SECRET here.
# ============================================================

# Base URL of the backend API (no trailing slash)
# Local dev:   http://localhost:3001/api
# Production:  https://your-backend.onrender.com/api  (set after deploying backend)
VITE_API_URL=http://localhost:3001/api

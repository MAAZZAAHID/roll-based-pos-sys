# ============================================================
# Retail POS — Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ============================================================

# Port the server listens on (cloud platforms set this automatically)
PORT=3001

# Neon PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# JWT signing secret — use a long random string (32+ chars)
JWT_SECRET=

# How long JWTs remain valid
JWT_EXPIRES_IN=8h

# Frontend origin(s) allowed to call this API
# Single origin:   http://localhost:5173
# Multiple origins: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
